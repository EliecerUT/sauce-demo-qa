{
  "name": "sauce-demo-qa",
  "version": "1.0.0",
  "description": "Proyecto de automatización E2E con playwright usando la página Saucedemo",
  "main": "index.js",
  "scripts": {
    "test": "npx bddgen && npx playwright test",
    "test:ui": "npx bddgen && npx playwright test --ui",
    "test:headed": "npx bddgen && npx playwright test --headed",
    "test:grep": "npx bddgen && npx playwright test --grep",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EliecerUT/sauce-demo-qa.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/EliecerUT/sauce-demo-qa/issues"
  },
  "homepage": "https://github.com/EliecerUT/sauce-demo-qa#readme",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "allure": "^3.21.0",
    "allure-playwright": "^3.13.0",
    "dotenv": "^18.0.8",
    "playwright-bdd": "^9.2.1"
  }
}
